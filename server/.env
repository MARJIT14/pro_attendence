# ──────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ──────────────────────────────────────────────
# MongoDB - Change this to your connection string
# ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017

# ──────────────────────────────────────────────
# JWT Secret - Use a strong random string in production
# ──────────────────────────────────────────────
JWT_SECRET=my-name-is-attendence----9876
JWT_EXPIRES_IN=5d

# ──────────────────────────────────────────────
# Geo-fence configuration (classroom boundaries)
# ──────────────────────────────────────────────
# Default classroom center coordinates 
GEO_LATITUDE=26.142737
GEO_LONGITUDE=91.789134
# Radius in meters (classroom size)
GEO_RADIUS_METERS=60s

# ──────────────────────────────────────────────
# QR Session TTL in seconds (30-60 recommended)
# ──────────────────────────────────────────────
QR_TTL_SECONDS=400

